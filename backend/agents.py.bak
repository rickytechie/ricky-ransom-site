from pathlib import Path
import os
from dotenv import load_dotenv

from crewai import Agent, Task, Crew

BASE_DIR = Path(__file__).resolve().parent
load_dotenv(BASE_DIR / ".env")

GROQ_API_KEY = os.getenv("GROQ_API_KEY", "your_key_here")
if not GROQ_API_KEY or GROQ_API_KEY.strip() in ("", "your_key_here"):
    # Allow placeholder for testing; production requires real key
    print("⚠️  WARNING: GROQ_API_KEY not set. Using placeholder for testing only.")
    print("   Add your real key to backend/.env: GROQ_API_KEY=your_actual_key")

# We must set this environment variable explicitly so CrewAI can grab it automatically
os.environ["GROQ_API_KEY"] = GROQ_API_KEY


def _build_content_prompt(company_description: str) -> str:
    return (
        "Analyze the provided business profile. Generate exactly 3 custom LinkedIn post hooks that are bold, concise, "
        "and designed to drive engagement, clicks, and B2B lead conversion. "
        "Return the answer as a short numbered list of hooks.\n\n"
        f"Business Description:\n{company_description.strip()}\n\n"
        "Example Output:\n"
        "1. Hook one\n"
        "2. Hook two\n"
        "3. Hook three"
    )


def _build_lead_prompt(target_market: str) -> str:
    return (
        "Analyze the target market. Identify 3 ideal buyer profile segments and explain each profile's likely technology bottlenecks and the best outreach angle. "
        "Format the response as a numbered list with each profile including:\n"
        "- Profile name / company type\n"
        "- Key role or decision-maker\n"
        "- Likely tech bottlenecks\n"
        "- Recommended outreach angle\n\n"
        f"Target Market:\n{target_market.strip()}\n\n"
        "Example Output:\n"
        "1. Profile Name / Company Type:\n"
        "   - Role:\n"
        "   - Likely tech bottlenecks:\n"
        "   - Outreach angle:"
    )


def _run_agent(prompt: str, variable_name: str, value: str, role_title: str, goal_text: str, backstory_text: str) -> str:
    # CrewAI natively manages models using a simple string identifier.
    # Passing the exact string 'groq/llama3-8b-8192' clears the Pydantic type validator perfectly.
    agent = Agent(
        role=role_title,
        goal=goal_text,
        backstory=backstory_text,
        llm="groq/llama3-8b-8192",
        verbose=True,
        allow_delegation=False
    )

    task = Task(
        description=prompt,
        expected_output="A plain text numbered list as requested by the prompt.",
        agent=agent,
    )

    # Crew receives ONLY agents, tasks, and verbose parameters
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
    )

    crew_output = crew.kickoff(inputs={variable_name: value})

    # Force clean serialization for FastAPI to prevent the client side from hanging.
    if hasattr(crew_output, "raw"):
        return str(crew_output.raw)
    return str(crew_output)


def run_content_generator(company_description: str) -> str:
    """Run the Social Media Strategist workflow and return three LinkedIn hooks."""
    prompt = _build_content_prompt(company_description)
    return _run_agent(
        prompt=prompt, 
        variable_name="company_description", 
        value=company_description,
        role_title="Social Media Strategist",
        goal_text="Create high-converting LinkedIn post hooks tailored specifically to a company's target value proposition.",
        backstory_text="An expert digital copywriter skilled at pulling high-converting conversion loops out of core business metrics."
    )


def run_lead_research(target_market: str) -> str:
    """Run the Autonomous Lead Researcher workflow and return three B2B profile recommendations."""
    prompt = _build_lead_prompt(target_market)
    return _run_agent(
        prompt=prompt, 
        variable_name="target_market", 
        value=target_market,
        role_title="Autonomous Lead Researcher",
        goal_text="Discover ideal client profiles, technical bottlenecks, and optimal B2B outreach blueprints for cold acquisition campaigns.",
        backstory_text="A data-driven market intelligence scraper specialized in isolating technical inefficiencies in emerging business sectors."
    )